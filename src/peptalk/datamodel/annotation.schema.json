{
    "$defs": {
        "Annotation": {
            "additionalProperties": false,
            "description": "One answer to one task for one sequence, with provenance, checks and cost. A reused (cached) answer keeps the uid of the call that produced it, so merged exports deduplicate on uid.",
            "properties": {
                "annotator_version": {
                    "description": "The peptalk version that made the call.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "answer": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Any"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The answer object parsed from the reply: open-ended, shaped by the template (its JSON Schema is `peptalk tasks --schema TASK`)."
                },
                "batch": {
                    "description": "True if asked through a provider batch API.",
                    "type": "boolean"
                },
                "batch_id": {
                    "description": "The provider's batch id.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "cached": {
                    "description": "True if this answer was reused from the store instead of asked again.",
                    "type": "boolean"
                },
                "checks": {
                    "description": "The automatic checks of the answer.",
                    "items": {
                        "$ref": "#/$defs/Check"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "client": {
                    "description": "The client library and its version.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "condition": {
                    "$ref": "#/$defs/Condition",
                    "description": "The real sequence, or its shuffled copy (the control)."
                },
                "confidence": {
                    "$ref": "#/$defs/Confidence",
                    "description": "peptalk's own result from its checks (not the model's stated confidence, which is in the answer)."
                },
                "context": {
                    "$ref": "#/$defs/HeaderContext",
                    "description": "How much of the FASTA header the model saw."
                },
                "cost_usd": {
                    "description": "Cost in US dollars at list price, if the model has a price.",
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "description": {
                    "description": "The rest of the FASTA header line.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "duration_ms": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "effort": {
                    "description": "The effort or thinking level, in the provider's own labels.",
                    "type": "string"
                },
                "error": {
                    "description": "Why the call failed, if it did.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "expected": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Verdict"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The verdict a claim expected. Never sent to the model."
                },
                "expected_input_tokens": {
                    "description": "The provider's count of the request alone; checked against the reported input.",
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "fallback_used": {
                    "description": "True if a server-side fallback model answered instead of the one requested.",
                    "type": "boolean"
                },
                "finished_at": {
                    "description": "When the call finished (ISO 8601, UTC).",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "header": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Any"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Every field parsed from the FASTA header (accession, organism, taxon id, ...)."
                },
                "id": {
                    "description": "The first word of the sequence's FASTA header, as given.",
                    "type": "string"
                },
                "model": {
                    "description": "The model requested.",
                    "type": "string"
                },
                "note": {
                    "description": "The claim's note. Never sent to the model.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "options": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Any"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Every request field besides the prompt, as sent."
                },
                "output": {
                    "$ref": "#/$defs/OutputMode",
                    "description": "Free text parsed for JSON (the default), or provider structured output."
                },
                "params": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Any"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The template's parameters (ask templates)."
                },
                "payload": {
                    "description": "Optional answer keys asked for (confidence, rationale, evidence, alternatives).",
                    "items": {
                        "type": "string"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "prompt_sha256": {
                    "description": "SHA-256 of the full prompt sent.",
                    "type": "string"
                },
                "prompt_version": {
                    "description": "First 12 hex digits of the SHA-256 of the template's prompt file.",
                    "type": "string"
                },
                "provider": {
                    "description": "anthropic, gemini, openai, or stub.",
                    "type": "string"
                },
                "response_id": {
                    "description": "The provider's id for the response.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "seq_md5": {
                    "description": "MD5 of the upper-case residues asked, the checksum UniParc uses. The key to the sequence.",
                    "type": "string"
                },
                "sequence": {
                    "description": "The residues asked (for a shuffled control, the shuffled residues).",
                    "type": "string"
                },
                "sequence_length": {
                    "type": "integer"
                },
                "served_model": {
                    "description": "The model that answered, as the provider reports it.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "started_at": {
                    "description": "When the call started (ISO 8601, UTC).",
                    "type": "string"
                },
                "stop_reason": {
                    "description": "Why the model stopped, as the provider reports it; `refusal:<category>` for a refusal.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "task": {
                    "description": "The template asked.",
                    "type": "string"
                },
                "text": {
                    "description": "The model's reply, verbatim.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "uid": {
                    "description": "The call that produced the answer.",
                    "type": "string"
                },
                "usage": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Usage"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "Token counts."
                },
                "validation_error": {
                    "description": "Why the answer object failed the template's answer model, if it did.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "uid",
                "id",
                "task",
                "condition",
                "sequence",
                "seq_md5",
                "sequence_length",
                "provider",
                "model",
                "effort",
                "fallback_used",
                "prompt_version",
                "prompt_sha256",
                "context",
                "output",
                "batch",
                "cached",
                "confidence",
                "started_at"
            ],
            "title": "Annotation",
            "type": "object"
        },
        "Any": {
            "additionalProperties": true,
            "description": "Any value (an open-ended object).",
            "title": "Any",
            "type": [
                "null",
                "boolean",
                "object",
                "number",
                "string"
            ]
        },
        "Check": {
            "additionalProperties": false,
            "description": "One automatic check of an answer against the sequence, the claim or the shuffled control.",
            "properties": {
                "detail": {
                    "description": "What failed, if anything.",
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "passed": {
                    "type": "boolean"
                }
            },
            "required": [
                "name",
                "passed",
                "detail"
            ],
            "title": "Check",
            "type": "object"
        },
        "Claim": {
            "additionalProperties": false,
            "description": "One claim about one protein.",
            "properties": {
                "expected": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Verdict"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The verdict you expect, for benchmarks. Never sent to the model and not part of the cache key."
                },
                "id": {
                    "description": "The protein, as the first word of its FASTA header.",
                    "type": "string"
                },
                "note": {
                    "description": "Any text. Kept with the result, never sent to the model.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "params": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Any"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The template's parameters, all of them and no others, such as {position: 436, residue: D}. Values may be written as numbers; they are read as text."
                },
                "task": {
                    "description": "The ask template that puts the claim to the model, such as ask-catalytic-residue (`peptalk tasks --ask` lists them).",
                    "type": "string"
                }
            },
            "required": [
                "id",
                "task"
            ],
            "title": "Claim",
            "type": "object"
        },
        "ClaimBody": {
            "additionalProperties": false,
            "description": "One claim, without the protein it is about (as written under a protein).",
            "properties": {
                "expected": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Verdict"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The verdict you expect, for benchmarks. Never sent to the model and not part of the cache key."
                },
                "note": {
                    "description": "Any text. Kept with the result, never sent to the model.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "params": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Any"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The template's parameters, all of them and no others, such as {position: 436, residue: D}. Values may be written as numbers; they are read as text."
                },
                "task": {
                    "description": "The ask template that puts the claim to the model, such as ask-catalytic-residue (`peptalk tasks --ask` lists them).",
                    "type": "string"
                }
            },
            "required": [
                "task"
            ],
            "title": "ClaimBody",
            "type": "object"
        },
        "ClaimsFile": {
            "additionalProperties": false,
            "description": "A claims file. Claims are grouped by protein (`proteins`) or listed flat (`claims`), or both. Write it in YAML; TSV and CSV with one row per claim are accepted for bulk input.",
            "properties": {
                "claims": {
                    "description": "Claims listed one by one, each naming its protein.",
                    "items": {
                        "$ref": "#/$defs/Claim"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "proteins": {
                    "description": "Claims grouped by protein.",
                    "items": {
                        "$ref": "#/$defs/ProteinClaims"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                }
            },
            "title": "ClaimsFile",
            "type": "object"
        },
        "Condition": {
            "description": "",
            "enum": [
                "real",
                "shuffled"
            ],
            "title": "Condition",
            "type": "string"
        },
        "Confidence": {
            "description": "",
            "enum": [
                "checks_passed",
                "flagged",
                "no_answer"
            ],
            "title": "Confidence",
            "type": "string"
        },
        "HeaderContext": {
            "description": "",
            "enum": [
                "blind",
                "organism",
                "full"
            ],
            "title": "HeaderContext",
            "type": "string"
        },
        "OutputMode": {
            "description": "",
            "enum": [
                "text",
                "json_schema"
            ],
            "title": "OutputMode",
            "type": "string"
        },
        "ProteinClaims": {
            "additionalProperties": false,
            "description": "The claims about one protein.",
            "properties": {
                "claims": {
                    "description": "The claims about this protein.",
                    "items": {
                        "$ref": "#/$defs/ClaimBody"
                    },
                    "type": "array"
                },
                "id": {
                    "description": "The protein, as the first word of its FASTA header.",
                    "type": "string"
                }
            },
            "required": [
                "id",
                "claims"
            ],
            "title": "ProteinClaims",
            "type": "object"
        },
        "Usage": {
            "additionalProperties": false,
            "description": "Token counts for one call. thinking_tokens is a part of output_tokens when reported.",
            "properties": {
                "cache_creation_input_tokens": {
                    "type": "integer"
                },
                "cache_read_input_tokens": {
                    "type": "integer"
                },
                "input_tokens": {
                    "type": "integer"
                },
                "output_tokens": {
                    "type": "integer"
                },
                "thinking_tokens": {
                    "type": [
                        "integer",
                        "null"
                    ]
                }
            },
            "required": [
                "input_tokens",
                "output_tokens",
                "cache_read_input_tokens",
                "cache_creation_input_tokens"
            ],
            "title": "Usage",
            "type": "object"
        },
        "Verdict": {
            "description": "",
            "enum": [
                "yes",
                "no",
                "uncertain"
            ],
            "title": "Verdict",
            "type": "string"
        }
    },
